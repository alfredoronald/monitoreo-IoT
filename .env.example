# ===== Backend (copiar a backend/.env) =====

# PostgreSQL local
PG_HOST=localhost
PG_PORT=5432
PG_DB=monitoreo_ambiental
PG_USER=app
PG_PASS=

# MQTT (Mosquitto local)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=api
MQTT_PASS=

# API
API_PORT=3000
# Clave de acceso a la API (HU-07, Sprint 3). Vacío = deshabilitado
API_KEY=

# Origen permitido para CORS (dev)
CORS_ORIGIN=http://localhost:5173
