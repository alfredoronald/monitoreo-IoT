# ===== Backend (copiar a backend/.env) =====

# PostgreSQL local
PG_HOST=localhost
PG_PORT=5432
PG_DB=monitoreo_ambiental
PG_USER=app
# Contraseña del rol "app": se completa SOLO en backend/.env (gitignored),
# nunca aquí. Pasos en infra/postgres/README.md
PG_PASS=

# ===== Alternativa: Supabase (PostgreSQL en la nube) =====
# Descomentar para usar Supabase en lugar del PostgreSQL local.
# Credenciales: Supabase → Project Settings → Database
# (la base se llama "postgres" y el usuario es "postgres")
# SUPABASE_HOST=db.<proyecto>.supabase.co
# SUPABASE_PORT=5432
# SUPABASE_DB=postgres
# SUPABASE_USER=postgres
# SUPABASE_PASS=

# MQTT (Mosquitto local)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=backend
MQTT_PASS=

# API
API_PORT=3000
# Clave de acceso a la API (HU-07, Sprint 3). Vacío = deshabilitado
API_KEY=

# Origen permitido para CORS (dev)
CORS_ORIGIN=http://localhost:5173
