{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST + suscriptor MQTT del monitoreo ambiental",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/db.test.ts tests/messageValidator.test.ts tests/mqttSubscriber.test.ts tests/messageLogger.test.ts tests/airStatusRoutes.test.ts tests/latestReadings.test.ts tests/historicalReadings.test.ts",
    "test:integration:latest": "tsx --test tests/latestReadings.integration.test.ts",
    "test:integration:history": "tsx --test tests/historicalReadings.integration.test.ts",
    "test:air-status": "tsx --test tests/airStatusRoutes.test.ts",
    "evidence:validation": "tsx scripts/messageValidationEvidence.ts",
    "test:load": "tsx scripts/loadTest100.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mqtt": "^5.10.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
